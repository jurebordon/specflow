.DS_Store

# SpecFlow operational docs (not to be confused with framework templates)
docs_specflow/

# SpecFlow's own generated files (we maintain templates/, not rendered output)
.claude/

# Root package-lock (CLI has its own in cli/)
package-lock.json

# Build artefact: written by cli prepublishOnly, never committed
cli/templates/

# Dependencies (root is an npm workspace root; cli/ has its own)
node_modules/
